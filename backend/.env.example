# Converge Backend Configuration
DATABASE_URL=postgresql+psycopg2://converge:converge@localhost:5433/converge
SECRET_KEY=change-me-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
REPUTATION_DEFAULT=3.0
REPUTATION_MIN_SIGNALS_FOR_TRUST=3
REPUTATION_HALF_LIFE_DAYS=90
REPUTATION_IDLE_DECAY_DAYS=180
REPUTATION_IDLE_DECAY_STRENGTH=0.35
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development
